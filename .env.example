# Copia este archivo como .env y completa los valores.
# En Hostinger, estas variables se configuran en el panel de la app Node.js.

# --- Servidor ---------------------------------------------------------------
# Hostinger define PORT automáticamente; en local se usa 3000 si está vacío.
PORT=3000
# "production" activa HSTS, caché de estáticos y trust proxy.
NODE_ENV=development
# URL pública sin "/" final (canonical, Open Graph y sitemap.xml).
SITE_URL=https://www.morai.pe
# Número de proxies delante de la app (Hostinger: 1). Vacío en local.
TRUST_PROXY=

# --- Correo (SMTP) ------------------------------------------------------------
# Si SMTP_HOST o MAIL_TO están vacíos, los leads se guardan solo en data/leads.jsonl.
# Hostinger: smtp.hostinger.com, puerto 465 (SSL) o 587 (STARTTLS).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
# true para 465, false para 587. Vacío = se deduce del puerto.
SMTP_SECURE=
SMTP_USER=web@morai.pe
SMTP_PASS=
# Remitente: debe ser el mismo buzón de SMTP_USER (o un alias permitido).
MAIL_FROM="MORAI Web <web@morai.pe>"
# Destino de los leads (puedes poner varios separados por coma).
MAIL_TO=rodrigozx23@gmail.com

# --- Leads y anti-abuso -----------------------------------------------------------
# Archivo de respaldo de leads (JSON Lines). Por defecto: data/leads.jsonl
LEADS_FILE=
# Máximo de envíos del formulario por IP en la ventana de tiempo.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MIN=15
# Segundos mínimos entre que se carga la página y se envía el formulario (anti-bot).
MIN_FORM_SECONDS=3
