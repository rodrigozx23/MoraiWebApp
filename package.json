{
  "name": "morai-web",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio web corporativo de MORAI (HTML estático + PHP para el formulario), para Hostinger.",
  "scripts": {
    "build": "node src/build.js",
    "preview": "node src/build.js && php -S 127.0.0.1:8090 -t dist scripts/router.php",
    "test": "node --test",
    "placeholders": "node scripts/placeholders.js",
    "publish:branch": "node scripts/publish-branch.js",
    "zip": "node src/build.js && node scripts/zip-dist.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "ejs": "3.1.10"
  }
}
