<%
  // Parámetros:
  //   idPrefix  evita IDs duplicados entre el modal y /contacto
  //   php       true en /contacto: emite fragmentos PHP que rellenan valores y errores
  //             (?producto=, o un envío sin JavaScript con errores). Ver php/api/form-helpers.php
  var P = (typeof php !== 'undefined') && php === true;
  var q = function (s) { return JSON.stringify(s); };
  var id = function (name) { return idPrefix + '-' + name; };
  var val = function (n) { return P ? '<?= morai_v(' + q(n) + ') ?>' : ''; };
  var err = function (n) { return P ? '<?= morai_e(' + q(n) + ') ?>' : ''; };
  var inv = function (n) { return P ? '<?= morai_invalid(' + q(n) + ') ?>' : ''; };
  var sel = function (n, v) { return P ? '<?= morai_sel(' + q(n) + ', ' + q(v) + ') ?>' : ''; };
  var plans = Object.entries(site.pricing).filter(function (x) { return Array.isArray(x[1]); });
%>
<form class="demo-form" action="/api/demo" method="post" data-demo-form>
  <div class="form-alert" role="alert" data-form-alert<%- P ? '<?= morai_e("_") === "" ? " hidden" : "" ?>' : ' hidden' %>><%- err('_') %></div>

  <div class="form-grid">
    <div class="field">
      <label for="<%= id('nombre') %>">Nombre y apellido *</label>
      <input id="<%= id('nombre') %>" name="nombre" type="text" autocomplete="name" required minlength="2" maxlength="80" value="<%- val('nombre') %>"<%- inv('nombre') %>>
      <p class="field-error" data-error-for="nombre"><%- err('nombre') %></p>
    </div>
    <div class="field">
      <label for="<%= id('email') %>">Correo electrónico *</label>
      <input id="<%= id('email') %>" name="email" type="email" autocomplete="email" required maxlength="120" value="<%- val('email') %>"<%- inv('email') %>>
      <p class="field-error" data-error-for="email"><%- err('email') %></p>
    </div>
    <div class="field">
      <label for="<%= id('telefono') %>">Teléfono / WhatsApp</label>
      <input id="<%= id('telefono') %>" name="telefono" type="tel" autocomplete="tel" maxlength="25" value="<%- val('telefono') %>"<%- inv('telefono') %>>
      <p class="field-error" data-error-for="telefono"><%- err('telefono') %></p>
    </div>
    <div class="field">
      <label for="<%= id('empresa') %>">Empresa o negocio</label>
      <input id="<%= id('empresa') %>" name="empresa" type="text" autocomplete="organization" maxlength="120" value="<%- val('empresa') %>"<%- inv('empresa') %>>
      <p class="field-error" data-error-for="empresa"><%- err('empresa') %></p>
    </div>
    <div class="field">
      <label for="<%= id('producto') %>">¿Qué te interesa? *</label>
      <select id="<%= id('producto') %>" name="producto" required data-producto<%- inv('producto') %>>
        <option value="">Elige una opción</option>
        <% Object.entries(site.products).forEach(function (p) { %>
        <option value="<%= p[0] %>"<%- sel('producto', p[0]) %>><%= p[1].name %></option>
        <% }) %>
      </select>
      <p class="field-error" data-error-for="producto"><%- err('producto') %></p>
    </div>
    <div class="field">
      <label for="<%= id('plan') %>">Plan (opcional)</label>
      <select id="<%= id('plan') %>" name="plan" data-plan<%- inv('plan') %>>
        <option value="">Aún no lo sé</option>
        <% plans.forEach(function (group) { %>
        <optgroup label="<%= site.products[group[0]] ? site.products[group[0]].name : group[0] %>" data-group="<%= group[0] %>">
          <% group[1].forEach(function (plan) { %>
          <option value="<%= plan.key %>"<%- sel('plan', plan.key) %>><%= plan.name %></option>
          <% }) %>
        </optgroup>
        <% }) %>
      </select>
      <p class="field-error" data-error-for="plan"><%- err('plan') %></p>
    </div>
    <div class="field field-full">
      <label for="<%= id('mensaje') %>">Cuéntanos sobre tu negocio</label>
      <textarea id="<%= id('mensaje') %>" name="mensaje" rows="3" maxlength="2000" placeholder="Ej.: tengo 2 locales y quiero integrar la cocina con la caja."><%- val('mensaje') %></textarea>
      <p class="field-error" data-error-for="mensaje"><%- err('mensaje') %></p>
    </div>
  </div>

  <%# Honeypot: invisible para personas, los bots suelen llenarlo. %>
  <div class="hp" aria-hidden="true">
    <label for="<%= id('website') %>">No llenar este campo</label>
    <input id="<%= id('website') %>" name="website" type="text" tabindex="-1" autocomplete="off">
  </div>
  <%# ts = momento en que se cargó el formulario (anti-bot). En HTML estático lo llena main.js. %>
  <input type="hidden" name="ts" value="<%- P ? '<?= (int) (microtime(true) * 1000) ?>' : '' %>" data-ts>
  <input type="hidden" name="origen" value="<%= page.path %>">

  <div class="field field-check">
    <input id="<%= id('consentimiento') %>" name="consentimiento" type="checkbox" required<%- P ? '<?= morai_checked("consentimiento") ?>' : '' %>>
    <label for="<%= id('consentimiento') %>">Acepto la <a href="/privacidad" target="_blank">política de privacidad</a> y que <%= site.name %> me contacte. *</label>
  </div>
  <p class="field-error" data-error-for="consentimiento"><%- err('consentimiento') %></p>

  <button class="btn btn-primary btn-block" type="submit" data-submit>Solicitar demo gratis</button>
  <p class="form-note muted">Te respondemos en menos de 24 horas hábiles.</p>
</form>
